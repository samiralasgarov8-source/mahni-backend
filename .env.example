# SECTION 7: Bu faylı .env kimi kopyalayıb açarlarını doldur.
# Hamısı boş qala bilər — belə olduqda bütün servislər DEMO rejimində işləyəcək.
# cp .env.example .env

ENV=development
DEBUG=true
ALLOWED_ORIGINS=*

# --- Verilənlər bazası ---
# Lokal: sqlite (default). Render Postgres: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# --- YouTube / Google OAuth ---
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/youtube/callback

# --- AdSense ---
ADSENSE_ACCOUNT_ID=

# --- Şəkil (Pexels) ---
PEXELS_API_KEY=

# --- TTS ---
TTS_PROVIDER=gtts
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Tərcümə ---
TRANSLATE_PROVIDER=deep_translator

# --- Fayl saxlama ---
MEDIA_ROOT=./media
PUBLIC_BASE_URL=http://localhost:8000
